<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tx.dao.MtypeMapper">
  <resultMap id="BaseResultMap" type="cn.tx.model.Mtype">
    <id column="TID" jdbcType="INTEGER" property="tid" />
    <result column="TNAME" jdbcType="VARCHAR" property="tname" />
    <result column="TDESC" jdbcType="VARCHAR" property="tdesc" />
  </resultMap>

  <sql id="Base_Column_List">
    TID, TNAME, TDESC
  </sql>

  <!-- 原有单条查询（保留） -->
  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from mtype
    where TID = #{tid,jdbcType=INTEGER}
  </select>

  <!-- 优化版selectAll：复用BaseResultMap，显式指定字段（推荐） -->
  <!--<select id="selectAll" resultMap="BaseResultMap">-->
    <!--select-->
    <!--<include refid="Base_Column_List" />-->
    <!--from mtype-->
  <!--</select>-->

  <!-- 原有删除（保留） -->
  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from mtype
    where TID = #{tid,jdbcType=INTEGER}
  </delete>

  <!-- 原有新增（保留） -->
  <insert id="insert" parameterType="cn.tx.model.Mtype">
    insert into mtype (TID, TNAME, TDESC
    )
    values (#{tid,jdbcType=INTEGER}, #{tname,jdbcType=VARCHAR}, #{tdesc,jdbcType=VARCHAR}
    )
  </insert>

  <!-- 原有选择性新增（保留） -->
  <insert id="insertSelective" parameterType="cn.tx.model.Mtype">
    insert into mtype
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="tid != null">
        TID,
      </if>
      <if test="tname != null">
        TNAME,
      </if>
      <if test="tdesc != null">
        TDESC,
      </if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="tid != null">
        #{tid,jdbcType=INTEGER},
      </if>
      <if test="tname != null">
        #{tname,jdbcType=VARCHAR},
      </if>
      <if test="tdesc != null">
        #{tdesc,jdbcType=VARCHAR},
      </if>
    </trim>
  </insert>

  <!-- 原有选择性更新（保留） -->
  <update id="updateByPrimaryKeySelective" parameterType="cn.tx.model.Mtype">
    update mtype
    <set>
      <if test="tname != null">
        TNAME = #{tname,jdbcType=VARCHAR},
      </if>
      <if test="tdesc != null">
        TDESC = #{tdesc,jdbcType=VARCHAR},
      </if>
    </set>
    where TID = #{tid,jdbcType=INTEGER}
  </update>

  <!-- 原有全字段更新（保留） -->
  <update id="updateByPrimaryKey" parameterType="cn.tx.model.Mtype">
    update mtype
    set TNAME = #{tname,jdbcType=VARCHAR},
    TDESC = #{tdesc,jdbcType=VARCHAR}
    where TID = #{tid,jdbcType=INTEGER}
  </update>

  <!-- 优化分页查询：修复SQL注入风险（concat替代${}） -->
  <select id="selectByPage" parameterType="cn.tx.query.MtypeQuery" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from mtype
    <where>
      <if test="tname != null and tname != '' ">
        tname like concat('%', #{tname}, '%')
      </if>
    </where>
    limit #{startNum},#{pageSize}
  </select>

  <!-- 优化总数查询：修复SQL注入风险 + 复用条件 -->
  <select id="selectCount" parameterType="cn.tx.query.MtypeQuery" resultType="java.lang.Integer">
    select count(*) from mtype
    <where>
      <if test="tname != null and tname != '' ">
        tname like concat('%', #{tname}, '%')
      </if>
    </where>
  </select>

  <select id="selectAll" resultType="cn.tx.model.Mtype">
    select * from mtype
  </select>

</mapper>